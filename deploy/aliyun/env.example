# Generate passwords and JWT values with:
# node deploy/aliyun/scripts/generate-secrets.mjs > deploy/aliyun/.env

POSTGRES_PASSWORD=replace-me
AUTHENTICATOR_PASSWORD=replace-me
PGRST_JWT_SECRET=replace-me
DATABASE_REST_SERVICE_KEY=replace-me

# Keep this equal to the public key used by timing-api.js for the first test.
TIMING_PUBLIC_KEY=replace-with-browser-public-key
LEADERBOARD_CLEAR_CODE=replace-me

# Local Docker defaults. Replace both URLs with the RDS internal endpoint on ECS.
TARGET_DATABASE_URL=postgresql://postgres:replace-me@postgres:5432/timing
PGRST_DB_URI=postgresql://timing_authenticator:replace-me@postgres:5432/timing

# Required only while copying production data into an empty target database.
SOURCE_DATABASE_URL=
ALLOW_EMPTY_TARGET_RESET=NO
